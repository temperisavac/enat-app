rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Obras Collection
    match /obras/{obraId} {
      allow get, list: if isSignedIn() && (!('ownerId' in resource.data) || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid && isValidId(obraId);
      allow update: if isSignedIn() && (!('ownerId' in existing()) || existing().ownerId == request.auth.uid);
      allow delete: if isSignedIn() && (!('ownerId' in existing()) || existing().ownerId == request.auth.uid);
    }

    // Invoices Collection
    match /invoices/{invoiceId} {
      allow get, list: if isSignedIn() && (!('ownerId' in resource.data) || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid && isValidId(invoiceId);
      allow update: if isSignedIn() && (!('ownerId' in existing()) || existing().ownerId == request.auth.uid);
      allow delete: if isSignedIn() && (!('ownerId' in existing()) || existing().ownerId == request.auth.uid);
    }

    // Labor Records Collection
    match /labor/{laborId} {
      allow get, list: if isSignedIn() && (!('ownerId' in resource.data) || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid && isValidId(laborId);
      allow update: if isSignedIn() && (!('ownerId' in existing()) || existing().ownerId == request.auth.uid);
      allow delete: if isSignedIn() && (!('ownerId' in existing()) || existing().ownerId == request.auth.uid);
    }

    // Manual Expenses (Despesas sem fatura) Collection
    match /manual_expenses/{expenseId} {
      allow get, list: if isSignedIn() && (!('ownerId' in resource.data) || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid && isValidId(expenseId);
      allow update: if isSignedIn() && (!('ownerId' in existing()) || existing().ownerId == request.auth.uid);
      allow delete: if isSignedIn() && (!('ownerId' in existing()) || existing().ownerId == request.auth.uid);
    }

    // Client Payments (Recebimentos do cliente) Collection
    match /client_payments/{paymentId} {
      allow get, list: if isSignedIn() && (!('ownerId' in resource.data) || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid && isValidId(paymentId);
      allow update: if isSignedIn() && (!('ownerId' in existing()) || existing().ownerId == request.auth.uid);
      allow delete: if isSignedIn() && (!('ownerId' in existing()) || existing().ownerId == request.auth.uid);
    }
  }
}
